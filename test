public String getTppId() {

    var securityContext = securityContextProvide.get();

    if (securityContext == null) {
        return null;
    }

    var subjectIdsOptional = securityContext.getOeMappedSubjectIds();

    if (subjectIdsOptional == null || !subjectIdsOptional.isPresent()) {
        return null;
    }

    var subjectIds = subjectIdsOptional.get();

    if (subjectIds == null) {
        return null;
    }

    var tppId = subjectIds.get("TPP_ID");

    return tppId != null ? tppId.toString() : null;
}
